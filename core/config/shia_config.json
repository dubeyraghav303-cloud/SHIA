{
  "monitors": [
    {
      "log_file": "/var/log/syslog",
      "rules": [
        {
          "pattern": ".*Out of memory.*",
          "action": "FLUSH_CACHE",
          "service": "system"
        },
        {
          "pattern": ".*Connection refused.*",
          "action": "RESTART_SERVICE",
          "service": "nginx"
        }
      ]
    },
    {
      "log_file": "/tmp/test_syslog.log",
      "rules": [
        {
          "pattern": ".*Segmentation Fault.*",
          "action": "RESTART_SERVICE",
          "service": "dummy_service"
        },
        {
          "pattern": ".*Out of Memory.*",
          "action": "FLUSH_CACHE",
          "service": "dummy_service"
        }
      ]
    }
  ],
